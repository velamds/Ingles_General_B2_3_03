{"_data": [{"type": "metadata", "contents": [{"content": "Good Prospects", "type": "lesson_name"}, {"content": "The Focus Groups Says ...", "type": "unit_name"}, {"content": 6, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 3, "type": "lesson"}, {"content": "B2.3", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Understand actions, events, and experiences in present, past or future and in spoken or written texts and in work and social contexts.", "type": "primary"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_1"}, {"content": "Integrates factual information to a wider range of written and spoken language skills and knowledge in the workplace.", "type": "secondary_2"}, {"content": "Integrates factual information to a wider range of written and spoken language skills and knowledge in the workplace. ", "type": "secondary_3"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_4"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_5"}, {"content": "Understands extended speeches, lectures, articles and reports of the professional, academic, or daily life on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear.", "type": "secondary_6"}, {"content": "Integrates factual information to a wider range of written and spoken language skills and knowledge in the workplace.", "type": "secondary_7"}, {"content": "Integrates factual information to a wider range of written and spoken language skills and knowledge in the workplace.", "type": "secondary_8"}]}, {"type": "target_word", "contents": [{"content": "lukewarm", "type": "name"}, {"content": "not very positive", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example:  It appears the reaction to my pitch has been lukewarm at best.", "type": "example"}, {"content": "engenn11le03ob06aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use when you give your opinion about a publication.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "lexical item", "type": "name"}, {"content": "word in a list", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: My concern is that the lexical items in the glossary might have been more complete.", "type": "example"}, {"content": "engenn11le03ob06aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "page reference", "type": "name"}, {"content": "in a book, in the glossary, the page number in which a word or topic appears", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: It would have been helpful to include page references.", "type": "example"}, {"content": "engenn11le03ob06aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "biography", "type": "name"}, {"content": "information related to the life of an important person", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I think the material could have included more biographies in the workbook related to history.", "type": "example"}, {"content": "engenn11le03ob06aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "bankruptcy", "type": "name"}, {"content": "the inability to pay personal debts", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The chapter on bankruptcy is misleading.", "type": "example"}, {"content": "engenn11le03ob06aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "microcredit", "type": "name"}, {"content": "lending small amounts of money to help people start their own business", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Did you consider examining the life of Muhammad Yunus, economist and inventor of microcredit?", "type": "example"}, {"content": "engenn11le03ob06aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "Nobel prize", "type": "name"}, {"content": "a series of annual awards that are given in Sweden for extraordinary accomplishments", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He won a Nobel prize for his work.", "type": "example"}, {"content": "engenn11le03ob06aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to allot", "type": "name"}, {"content": "to assign or to dedicate space, time or other resources", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Since there is no time allotted for that, it must have been ignored in the past.", "type": "example"}, {"content": "engenn11le03ob06aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "timetable", "type": "name"}, {"content": "the organization of events in a  schedule including dates and time", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: This subject area is not covered in the school timetable.", "type": "example"}, {"content": "engenn11le03ob06aud09", "type": "audio"}]}, {"content": "engenn11le03ob06re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " Present Perfect to Talk About Results", "type": "heading"}, {"content": "You use the<span class=\"strong\"> Present Perfect</span> tense with the verbs <span class=\"italic\">appear</span>, <span class=\"italic\">seem </span>and <span class=\"italic\">sound </span>to comment on the present results of something in the past. <br/> The expression <span class=\"italic\">It seems</span> ... can be followed by <span class=\"italic\">as if</span> or <span class=\"italic\">as though</span>.", "type": "describer"}, {"content": "For example:", "type": "text"}, {"content": "<span class=\"italic\">She <span class=\"strong\">sounds</span> as though <span class=\"strong\">she has had </span>a cold for days.</span> <br/> <span class=\"italic\">It <span class=\"strong\">seems</span> they'<span class=\"strong\">ve already decided </span> to go with another company.</span> <br/> <span class=\"italic\">It <span class=\"strong\">appears </span>as if <span class=\"strong\">they have been </span>hired to manage the group.</span>", "type": "text"}, {"content": "It appears the reaction to my pitch <span class=\"strong\">has been </span>lukewarm at best.", "type": "example"}, {"content": "It seems as if the articles <span class=\"strong\">have been written</span> with the grade level in mind. ", "type": "example"}, {"content": "It sounds as if the focus group participants<span class=\"strong\"> have taken</span> their role very seriously.", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " Talking About Uncertainty About the Past: Perfect Modal Verbs", "type": "heading"}, {"content": " Modal Perfects (modal + have + past participle) can refer to the past.", "type": "describer"}, {"content": "You use modal perfects in three ways.  <br/>Look at the chart for an outline of their usages.", "type": "text"}, {"content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Use\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" to speculate about events, or to imagine the opposite happened\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I <span class=\\\"strong\\\">would have called</span> him but I didn't have time. <br/> You <span class=\\\"strong\\\">should have told </span>me you were going. <br/> You <span class=\\\"strong\\\">might have warned </span>me.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" to talk about past events when we are not sure whether they happened or not\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I can't find my file - I suppose I <span class=\\\"strong\\\">could have left </span> it somewhere at home. <br/> She <span class=\\\"strong\\\">must have given </span>it to someone else.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" to talk about possibility in the present and future\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">You <span class=\\\"strong\\\">should have already </span>gone through customs by the time I get to the airport.</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "My concern is that the lexical items in the glossary<span class=\"strong\"> might have been </span>more complete, and you <span class=\"strong\">may have included </span>page references.", "type": "example"}, {"content": "However, some chapters <span class=\"strong\">may have been</span> better researched. ", "type": "example"}]}, {"type": "takeaway_extension", "contents": [{"content": "Choose any publication. It could be a reference book, a textbook, a brochure, a cookbook, etc.", "type": "text"}, {"content": "Write a 80 - 120-word paragraph giving your opinion on the publication. Say what you think is good and not good about it.", "type": "text"}, {"content": "Give specific comments about different parts of the publication. Try to use the words <span class=\"italic\">chapter</span>, <span class=\"italic\">glossary</span>, <span class=\"italic\">index</span>, <span class=\"italic\">cover page</span> and <span class=\"italic\">illustrations</span>.", "type": "text"}, {"content": "Conclude your paragraph with an overall opinion.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write focus group comments using appropriate vocabulary.", "type": "text"}, {"content": "I say what I think is good about a publication.", "type": "text"}, {"content": "I say what I think is bad about a publication.", "type": "text"}, {"content": "I give my overall opinion.", "type": "text"}]}], "type": "sena", "labs": [{"_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "type": "scholar", "id": 0, "stimuli": [{"_data": [], "type": "welcome", "template_override": 1, "id": 0, "contents": [{}]}, {"title": "", "id": 1, "contents": [{"type": "slideshow", "value": {"coverimg": "engenn11le03ob06re2img05.jpg", "audiosrc": "engenn11le03ob06re2aud01", "images": [{"time": "0", "image": "engenn11le03ob06re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn11le03ob06re2img05.jpg", "id": 1, "text": "<span class=\"strong\">Denise</span>: I am concerned about our sales in financial literacy, Boris.\n<br/><span class=\"strong\">Boris</span>: Really? It's early yet to be concerned, don't you think?\n<br/><span class=\"strong\">Denise</span>: Perhaps I was really excited about this project when we received the manuscript. Our market research showed that this was an area of need in the school system.\n<br/><span class=\"strong\">Boris</span>: So what's the problem?\n<br/><span class=\"strong\">Denise</span>:  It appears the reaction to my pitch has been lukewarm at best. People may not have understood the importance of teaching financial literacy.\n<br/><span class=\"strong\">Boris</span>: Since there is no time allotted for that in the school timetable, it must have been ignored in the past.\n<br/><span class=\"strong\">Denise</span>:  Exactly. We knew that would be a marketing challenge."}, {"time": "37500", "image": "engenn11le03ob06re2img06.jpg", "id": 2, "text": "<span class=\"strong\">Boris</span>: The transcript of our recent focus group is just in. Do you want to look at a few comments?\n<br/><span class=\"strong\">Denise</span>: Sure! That might give us some good ideas.<br/>\n<span class=\"strong\">Boris</span>: One participant said: \u201cI like the design and choice of colors. The explanations appear clear and consistent. It seems as if the articles have been written with the grade level in mind. My concern is that the lexical items in the glossary might have been more complete, and you may have included page references. That would have been helpful.\u201d\n<br/><span class=\"strong\">Denise</span>:  Mmmm that's interesting. Here's another one:  \u201cThese are excellent learning materials for a topic that is difficult to explain. I appreciate the real-life situations that are included in each chapter. I think the material could have included more biographies in the workbook related to history. Did you consider examining the life of Muhammad Yunus, economist and inventor of microcredit? He won a Nobel prize for his work.\u201d"}, {"time": "95000", "image": "engenn11le03ob06re2img07.jpg", "id": 3, "text": "<span class=\"strong\">Boris</span>: It sounds as if the focus group participants have taken their role very seriously. Let's read one more. \u201cI love teaching financial literacy. Your materials will help me teach more complicated notions, like supply and demand, interest rates and taxation. However, some chapters may have been better researched. The chapter on bankruptcy is misleading.\u201d\n<br/><span class=\"strong\">Denise</span>: Ouch!"}]}}], "_data": [], "type": "audio", "template_override": 1}], "exercises": [{"stimuli_ids": [0], "img_path": "", "id": 0, "_data": [{"type": "instructions", "contents": [{"content": " I can talk about the present result of events that started in the past in work and job issues.", "type": "Learning Outcomes"}, {"content": " I can talk about uncertainty in past events related to job issues.", "type": "Learning Outcomes"}, {"content": " I can explain arguments supporting different points of view.", "type": "Learning Outcomes"}, {"content": " Have you been part of a focus group? Would you like to be?", "type": "Free Header Item"}, {"content": " What are other ways companies get information about people's opinions on their products and services?", "type": "Free Header Item"}]}, {"type": "group", "contents": [{"content": "Welcome", "type": "group_name"}]}, {"content": {"incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct"}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "Let's ask the focus group that question.", "type": "free_type_text_area"}], "type": "WLC", "template_override": 1, "questions": []}, {"stimuli_ids": [1], "id": 1, "_data": [{"type": "instructions", "contents": [{"content": " Denise and Boris review the <span class=\"tool-tip\" id=\"tip_1_0\">transcript</span> of the focus group session.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Content", "type": "group_name"}]}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!"}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Listening", "type": "skill"}, {"content": "Reading", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Click on the play button to listen to the audio.", "type": "text"}]}, {"content": [{"content": "A <span class=\"italic\">\"transcript\"</span> is the written account of things that were said orally, such as during a meeting.", "type": "text", "tip_id": 0}], "type": "tips"}], "type": "STI", "template_override": 1, "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"_data": [{"content": "", "type": "text"}], "correct": 0, "selected": 0, "id": 0}, {"_data": [{"content": "", "type": "text"}], "correct": 1, "selected": 0, "id": 1}], "id": 0}]}, {"stimuli_ids": [], "id": 2, "_data": [{"type": "instructions", "contents": [{"content": " \nWhat points of view are given around the table?\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 1", "type": "group_name"}]}, {"content": {"incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!"}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Listen to the dialogue. Select the correct answer.\n <br/>You have 2 attempts to submit your answers.\n", "type": "text"}, {"content": "engenn11le03ob06re2aud01", "type": "audio"}]}], "type": "DMC", "template_override": 1, "questions": [{"_data": [{